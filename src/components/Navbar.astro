---
import { Menu, X, ChevronDown, PhoneCall } from 'lucide-react';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-charcoal text-white border-b border-white/10 shadow-xl transition-all duration-300" id="main-header">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 h-20 flex items-center justify-between">
    
    {/* Logo — Original full colors placed directly on the dark navbar */}
    <a href="/" class="flex-shrink-0 flex items-center">
      <img 
        src="/images/logo.png" 
        alt="Zain Group of Companies" 
        class="h-10 md:h-11 w-auto object-contain transition-transform duration-300 hover:scale-[1.02]" 
      />
    </a>

    {/* Desktop Navigation Links */}
    <nav class="hidden lg:flex items-center gap-10">
      <a href="/" class="text-xs font-sans font-bold tracking-widest uppercase text-white/90 hover:text-brand-green transition-colors duration-200 py-1 border-b-2 border-transparent hover:border-brand-green">Home</a>
      
      {/* Portfolio Dropdown */}
      <div class="relative group">
        <button class="flex items-center gap-1 text-xs font-sans font-bold tracking-widest uppercase text-white/90 hover:text-brand-green transition-colors duration-200 focus:outline-none py-2 border-b-2 border-transparent group-hover:border-brand-green">
          <span>Portfolio</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-60" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
        
        {/* Dark Luxury Mega Menu */}
        <div class="absolute left-1/2 -translate-x-1/2 mt-1 w-[500px] bg-charcoal border border-white/15 shadow-2xl rounded-md p-6 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 grid grid-cols-2 gap-8 text-white">
          <div>
            <h4 class="text-[10px] font-bold tracking-widest uppercase text-brand-green border-b border-white/10 pb-2 mb-3">Residential Landmarks</h4>
            <ul class="space-y-2.5">
              <li><a href="/projects/city-executive-tower" class="text-xs text-white/70 hover:text-white font-medium block transition-colors">City Executive Tower</a></li>
              <li><a href="/projects/sun-residency" class="text-xs text-white/70 hover:text-white font-medium block transition-colors">Sun Residency</a></li>
              <li><a href="/projects/afroz-mobile-mall-and-residency" class="text-xs text-white/70 hover:text-white font-medium block transition-colors">Afroz Residency</a></li>
              <li><a href="/projects/the-corner-apartment" class="text-xs text-white/70 hover:text-white font-medium block transition-colors">The Corner Apartment</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-[10px] font-bold tracking-widest uppercase text-brand-blue border-b border-white/10 pb-2 mb-3">Commercial Hubs</h4>
            <ul class="space-y-2.5">
              <li><a href="/projects/city-towers-shopping-mall" class="text-xs text-white/70 hover:text-white font-medium block transition-colors">City Towers & Shopping Mall</a></li>
              <li><a href="/projects/zain-shopping-mall" class="text-xs text-white/70 hover:text-white font-medium block transition-colors">Zain Shopping Mall</a></li>
              <li><a href="/projects/city-center-shopping-mall" class="text-xs text-white/70 hover:text-white font-medium block transition-colors">City Centre Mall</a></li>
              <li><a href="/projects/capital-center" class="text-xs text-white/70 hover:text-white font-medium block transition-colors">Capital Center</a></li>
            </ul>
          </div>
          <div class="col-span-2 border-t border-white/10 pt-3 text-center">
            <a href="/projects" class="text-xs font-bold tracking-wider uppercase text-brand-green hover:text-white transition-colors">Explore All Projects &rarr;</a>
          </div>
        </div>
      </div>

      <a href="/about-us" class="text-xs font-sans font-bold tracking-widest uppercase text-white/90 hover:text-brand-green transition-colors duration-200 py-1 border-b-2 border-transparent hover:border-brand-green">About</a>
      <a href="/blog" class="text-xs font-sans font-bold tracking-widest uppercase text-white/90 hover:text-brand-green transition-colors duration-200 py-1 border-b-2 border-transparent hover:border-brand-green">Blog</a>
      <a href="/contact" class="text-xs font-sans font-bold tracking-widest uppercase text-white/90 hover:text-brand-green transition-colors duration-200 py-1 border-b-2 border-transparent hover:border-brand-green">Contact</a>
    </nav>

    {/* Right side: Phone + CTA Button */}
    <div class="hidden lg:flex items-center gap-6">
      <a 
        href="tel:+923302382380" 
        class="text-xs font-medium text-white/80 hover:text-white transition-colors duration-200 flex items-center gap-2"
      >
        <PhoneCall className="w-3.5 h-3.5 text-brand-green" />
        <span class="text-white/50">Call Us:</span>
        <span class="text-white font-semibold">+92 330 2382380</span>
      </a>
      
      <a 
        href="/contact" 
        class="bg-brand-green text-white hover:bg-white hover:text-charcoal px-6 py-2.5 text-xs font-sans font-bold tracking-widest uppercase rounded-full transition-all duration-300 border border-brand-green hover:border-white shadow-md shadow-brand-green/20"
      >
        Get In Touch
      </a>
    </div>

    {/* Hamburger Toggle (Mobile) */}
    <button 
      id="hamburger-btn" 
      class="lg:hidden p-2 text-white hover:text-brand-green focus:outline-none" 
      aria-label="Toggle Menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6" id="burger-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  {/* Mobile Menu Drawer (Dark Luxury Theme) */}
  <div 
    id="mobile-drawer" 
    class="lg:hidden fixed inset-y-0 right-0 w-full max-w-sm bg-charcoal border-l border-white/10 shadow-2xl p-8 z-50 transform translate-x-full transition-transform duration-300 ease-in-out text-white"
  >
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/10">
      <img 
        src="/images/logo.png" 
        alt="Zain Group" 
        class="h-8 w-auto object-contain" 
      />
      <button id="close-drawer-btn" class="p-2 text-white/70 hover:text-white focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex flex-col space-y-5 text-base font-bold uppercase tracking-wider">
      <a href="/" class="text-white hover:text-brand-green border-b border-white/10 pb-2 transition-colors">Home</a>
      <a href="/apartments-for-sale" class="text-white hover:text-brand-green border-b border-white/10 pb-2 transition-colors">Apartments</a>
      <a href="/commercial-properties" class="text-white hover:text-brand-green border-b border-white/10 pb-2 transition-colors">Commercial</a>
      
      {/* Collapsible Mobile Projects */}
      <details class="group">
        <summary class="flex justify-between items-center text-white hover:text-brand-green border-b border-white/10 pb-2 cursor-pointer list-none">
          <span>Portfolio</span>
          <svg class="w-5 h-5 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </summary>
        <div class="mt-3 pl-4 space-y-4 text-xs font-normal">
          <div>
            <h5 class="text-[10px] font-bold uppercase tracking-widest text-brand-green mb-2">Residential</h5>
            <ul class="space-y-2 border-l border-white/10 pl-3">
              <li><a href="/projects/city-executive-tower" class="text-white/70">City Executive Tower</a></li>
              <li><a href="/projects/sun-residency" class="text-white/70">Sun Residency</a></li>
              <li><a href="/projects/afroz-mobile-mall-and-residency" class="text-white/70">Afroz Residency</a></li>
              <li><a href="/projects/the-corner-apartment" class="text-white/70">The Corner Apartment</a></li>
            </ul>
          </div>
          <div>
            <h5 class="text-[10px] font-bold uppercase tracking-widest text-brand-blue mb-2">Commercial</h5>
            <ul class="space-y-2 border-l border-white/10 pl-3">
              <li><a href="/projects/city-towers-shopping-mall" class="text-white/70">City Towers & Mall</a></li>
              <li><a href="/projects/zain-shopping-mall" class="text-white/70">Zain Shopping Mall</a></li>
              <li><a href="/projects/city-center-shopping-mall" class="text-white/70">City Centre Mall</a></li>
              <li><a href="/projects/capital-center" class="text-white/70">Capital Center</a></li>
            </ul>
          </div>
        </div>
      </details>

      <a href="/about-us" class="text-white hover:text-brand-green border-b border-white/10 pb-2 transition-colors">About</a>
      <a href="/blog" class="text-white hover:text-brand-green border-b border-white/10 pb-2 transition-colors">Blog</a>
      <a href="/contact" class="text-white hover:text-brand-green border-b border-white/10 pb-2 transition-colors">Contact</a>
    </nav>

    {/* Mobile CTAs */}
    <div class="mt-8 space-y-4">
      <a href="tel:+923302382380" class="flex items-center gap-2 text-sm text-white/80">
        <PhoneCall className="w-4 h-4 text-brand-green" />
        <span>+92 330 2382380</span>
      </a>
      <a 
        href="/contact" 
        class="bg-brand-green text-white hover:bg-white hover:text-charcoal text-center py-3 text-xs font-sans font-bold tracking-widest uppercase rounded-full transition-all duration-300 block"
      >
        Get In Touch
      </a>
      <a 
        href="https://api.whatsapp.com/send?phone=+923302382380&text=Hello" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="border border-white/20 text-white hover:bg-white hover:text-charcoal text-center py-3 text-xs font-sans font-bold tracking-widest uppercase rounded-full transition-all duration-300 block"
      >
        WhatsApp Us
      </a>
    </div>
  </div>
  
  {/* Backdrop overlay */}
  <div id="drawer-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden transition-opacity duration-300 opacity-0"></div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const closeDrawerBtn = document.getElementById('close-drawer-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const drawerOverlay = document.getElementById('drawer-overlay');

    // Mobile Drawer Open
    hamburgerBtn.addEventListener('click', () => {
      mobileDrawer.classList.remove('translate-x-full');
      drawerOverlay.classList.remove('hidden');
      setTimeout(() => {
        drawerOverlay.classList.add('opacity-100');
      }, 50);
      document.body.classList.add('overflow-hidden');
    });

    // Mobile Drawer Close
    const closeDrawer = () => {
      mobileDrawer.classList.add('translate-x-full');
      drawerOverlay.classList.remove('opacity-100');
      setTimeout(() => {
        drawerOverlay.classList.add('hidden');
      }, 300);
      document.body.classList.remove('overflow-hidden');
    };

    closeDrawerBtn.addEventListener('click', closeDrawer);
    drawerOverlay.addEventListener('click', closeDrawer);

    document.addEventListener('astro:after-swap', () => {
      closeDrawer();
    });
  });
</script>
