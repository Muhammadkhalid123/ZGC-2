---
import NewsletterForm from './NewsletterForm';
---

<footer class="bg-charcoal text-white">
  
  {/* Main Footer Grid */}
  <div class="max-w-[1200px] mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
    
    {/* Company Info */}
    <div class="flex flex-col space-y-6">
      <a href="/">
        <img 
          src="/images/logo.png" 
          alt="Zain Group of Companies" 
          class="h-12 w-auto object-contain self-start" 
        />
      </a>
      <p class="text-sm text-white/40 leading-relaxed font-light">
        Karachi's premier real estate builder and developer. Transforming urban landscapes through structural excellence and 25+ years of uncompromised quality.
      </p>
      
      {/* Social Links */}
      <div class="flex items-center space-x-3">
        <a 
          href="http://facebook.com/zgcpk" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center text-white/40 hover:text-white hover:border-white/30 transition-all duration-300"
          aria-label="Facebook Page"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
          </svg>
        </a>
        <a 
          href="https://www.instagram.com/zgcofficial?igsh=YXltbW5jdWZzd2Fn" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center text-white/40 hover:text-white hover:border-white/30 transition-all duration-300"
          aria-label="Instagram Profile"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </a>
        <a 
          href="https://www.youtube.com/@ZainGroupofCompanies" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center text-white/40 hover:text-white hover:border-white/30 transition-all duration-300"
          aria-label="YouTube Channel"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.163a3.003 3.003 0 00-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.516 0-9.388.508a3.003 3.003 0 00-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 002.11 2.11c1.872.508 9.388.508 9.388.508s7.517 0 9.388-.508a3.002 3.002 0 002.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
      </div>
    </div>

    {/* Quick Links */}
    <div class="flex flex-col space-y-6">
      <h3 class="text-[10px] font-sans font-bold tracking-widest uppercase text-white/30 border-b border-white/10 pb-2">Navigation</h3>
      <ul class="space-y-3">
        <li><a href="/" class="text-sm text-white/50 hover:text-white transition-colors font-light">Home</a></li>
        <li><a href="/about-us" class="text-sm text-white/50 hover:text-white transition-colors font-light">About Us</a></li>
        <li><a href="/projects" class="text-sm text-white/50 hover:text-white transition-colors font-light">All Projects</a></li>
        <li><a href="/blog" class="text-sm text-white/50 hover:text-white transition-colors font-light">Articles</a></li>
        <li><a href="/contact" class="text-sm text-white/50 hover:text-white transition-colors font-light">Contact</a></li>
      </ul>
    </div>

    {/* Projects */}
    <div class="flex flex-col space-y-6">
      <h3 class="text-[10px] font-sans font-bold tracking-widest uppercase text-white/30 border-b border-white/10 pb-2">Portfolio</h3>
      <ul class="space-y-3">
        <li><a href="/projects/city-executive-tower" class="text-sm text-white/50 hover:text-white transition-colors font-light">City Executive Tower</a></li>
        <li><a href="/projects/sun-residency" class="text-sm text-white/50 hover:text-white transition-colors font-light">Sun Residency</a></li>
        <li><a href="/projects/afroz-mobile-mall-and-residency" class="text-sm text-white/50 hover:text-white transition-colors font-light">Afroz Mobile Mall & Residency</a></li>
        <li><a href="/projects/city-towers-shopping-mall" class="text-sm text-white/50 hover:text-white transition-colors font-light">City Towers & Shopping Mall</a></li>
        <li><a href="/projects/zain-shopping-mall" class="text-sm text-white/50 hover:text-white transition-colors font-light">Zain Shopping Mall</a></li>
        <li><a href="/projects/the-corner-apartment" class="text-sm text-white/50 hover:text-white transition-colors font-light">The Corner Apartment</a></li>
      </ul>
    </div>

    {/* Contact & Newsletter */}
    <div class="flex flex-col space-y-6">
      <h3 class="text-[10px] font-sans font-bold tracking-widest uppercase text-white/30 border-b border-white/10 pb-2">Head Office</h3>
      <ul class="space-y-3 text-sm text-white/50 font-light">
        <li class="flex items-start space-x-2">
          <svg class="w-4 h-4 text-white/25 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Survey No. 535/1, Deh Mehran Tapo Airport, Malir, Karachi.</span>
        </li>
        <li class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-white/25 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <a href="tel:+923302382380" class="hover:text-white transition-colors">0330 2382380</a>
        </li>
        <li class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-white/25 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <a href="mailto:info@zgc.com.pk" class="hover:text-white transition-colors">info@zgc.com.pk</a>
        </li>
      </ul>
      
      {/* Newsletter signup */}
      <div class="pt-4 flex flex-col space-y-3">
        <h4 class="text-[10px] font-sans font-bold tracking-widest uppercase text-white/25">Newsletter</h4>
        <NewsletterForm client:visible />
      </div>
    </div>

  </div>

  {/* Copyright */}
  <div class="border-t border-white/5">
    <div class="max-w-[1200px] mx-auto px-6 py-6 flex flex-col sm:flex-row items-center justify-between text-xs text-white/25 gap-4">
      <p>&copy; {new Date().getFullYear()} Zain Group of Companies. All Rights Reserved.</p>
      <div class="flex items-center space-x-6">
        <a href="/privacy-policy" class="hover:text-white/50 transition-colors">Privacy Policy</a>
        <a href="/privacy-policy" class="hover:text-white/50 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
