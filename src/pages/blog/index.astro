---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Sort by date (newest first)
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout 
  title="Real Estate Insights & News | Zain Group of Companies" 
  description="Read articles, property comparisons, and real estate insights for Karachi. Learn tips about buying apartments, shop investments, and handovers."
>
  {/* Header */}
  <section class="bg-linen py-16 md:py-24 border-b border-charcoal/5">
    <div class="max-w-7xl mx-auto px-6 text-center space-y-4">
      <span class="text-xs font-bold tracking-[0.25em] uppercase text-accent-gold block">Property Intelligence</span>
      <h1 class="text-4xl md:text-6xl font-light font-display text-charcoal max-w-4xl mx-auto leading-tight">
        Zain Group Blog & Articles
      </h1>
      <p class="text-sm md:text-base text-charcoal/60 max-w-2xl mx-auto font-light leading-relaxed">
        Stay updated with expert insights on Karachi's real estate markets. From apartment inspection checklists to retail property ROI reviews.
      </p>
    </div>
  </section>

  {/* Blog Cards Grid */}
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
      {sortedPosts.map((post) => (
        <article class="flex flex-col space-y-4 group">
          
          {/* Cover image */}
          {/* TODO: replace with client-provided photography */}
          <div class="relative aspect-[16/10] overflow-hidden bg-charcoal rounded-sm border border-charcoal/5 shadow-md">
            {(() => {
              let blogImg = "/images/projects/sun-residency.jpg";
              if (post.data.title.toLowerCase().includes("handover") || post.data.title.toLowerCase().includes("checklist")) {
                blogImg = "/images/projects/sun-residency.jpg";
              } else if (post.data.title.toLowerCase().includes("compare") || post.data.title.toLowerCase().includes("projects")) {
                blogImg = "/images/projects/city-towers.jpg";
              } else if (post.data.title.toLowerCase().includes("luxury") || post.data.title.toLowerCase().includes("affordable")) {
                blogImg = "/images/projects/city-executive.jpg";
              } else if (post.data.title.toLowerCase().includes("shop") || post.data.title.toLowerCase().includes("office") || post.data.title.toLowerCase().includes("retail")) {
                blogImg = "/images/projects/afroz-residency.jpg";
              }
              return (
                <div 
                  class="w-full h-full bg-cover bg-center transition-transform duration-700 group-hover:scale-103" 
                  style={`background-image: linear-gradient(rgba(0,0,0,0.1), rgba(0,0,0,0.1)), url('${blogImg}');`}
                ></div>
              );
            })()}
            <div class="absolute bottom-3 left-3 bg-charcoal/80 text-linen px-2.5 py-1 text-[8px] font-bold tracking-widest uppercase border border-linen/10 rounded-sm">
              Article
            </div>
          </div>

          {/* Details */}
          <div class="space-y-2 flex-grow flex flex-col justify-between">
            <div class="space-y-2">
              <time class="text-[9px] font-bold text-accent-gold uppercase tracking-widest block">{post.data.date}</time>
              <h2 class="text-xl md:text-2xl font-light font-display text-charcoal leading-snug group-hover:text-accent-gold transition-colors">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <p class="text-xs text-charcoal/70 leading-relaxed line-clamp-3 font-light">
                {post.data.excerpt}
              </p>
            </div>
            
            <div class="pt-4 mt-4 border-t border-charcoal/5">
              <a 
                href={`/blog/${post.id}`} 
                class="inline-flex items-center space-x-2 text-[10px] font-bold tracking-wider uppercase text-charcoal hover:text-accent-gold transition-colors"
              >
                <span>Read Full Article &rarr;</span>
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>
  </section>

</BaseLayout>
