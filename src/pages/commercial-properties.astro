---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { MapPin, ArrowRight, Building2, Store } from 'lucide-react';

const allProjects = await getCollection('projects');
const commercialProjects = allProjects.filter(p => p.data.type === 'Commercial');
---

<BaseLayout 
  title="Commercial Properties for Sale in Karachi | Zain Group of Companies" 
  description="Explore commercial spaces, retail outlets, and shopping malls for sale in Karachi. Invest in high-ROI projects including City Towers, Zain Shopping Mall, and Capital Center."
>
  <section class="bg-linen py-16 md:py-24 border-b border-charcoal/5">
    <div class="max-w-7xl mx-auto px-6 text-center space-y-4">
      <span class="text-xs font-bold tracking-[0.25em] uppercase text-accent-gold block">Commercial Portfolio</span>
      <h1 class="text-4xl md:text-6xl font-light font-display text-charcoal max-w-3xl mx-auto leading-tight">
        Corporate Hubs & Shopping Malls in Karachi
      </h1>
      <p class="text-sm md:text-base text-charcoal/60 max-w-xl mx-auto font-light leading-relaxed">
        Invest in Karachi's commercial real estate with high footfall shopping complexes and prime corporate addresses designed by ZGC to drive retail success and business value.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      {commercialProjects.map((project) => (
        <div class="flex flex-col space-y-6 group">
          
          {/* Project Cover Banner */}
          <!-- TODO: replace with client-provided photography -->
          <div class="relative aspect-[16/10] overflow-hidden bg-charcoal rounded-sm shadow-xl border border-charcoal/5">
            <img 
              src={
                project.data.title === "City Towers & Shopping Mall" ? "/images/projects/city-towers.jpg" 
                : project.data.title === "Zain Shopping Mall" ? "/images/projects/banner-2.jpg"
                : project.data.title === "City Centre Shopping Mall" ? "/images/projects/banner-4.jpg"
                : "/images/projects/banner-5.jpg"
              } 
              alt={project.data.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-103" 
            />
            <div class="absolute top-4 right-4 bg-charcoal/80 backdrop-blur-md text-linen px-3 py-1.5 text-[9px] font-bold tracking-widest uppercase rounded-sm border border-linen/10">
              {project.data.status}
            </div>
          </div>

          {/* Project Details */}
          <div class="space-y-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-2xl md:text-3xl font-light font-display text-charcoal group-hover:text-accent-gold transition-colors">
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h2>
                <div class="flex items-center space-x-1.5 text-xs text-charcoal/50 mt-1">
                  <MapPin className="w-3.5 h-3.5 flex-shrink-0 text-accent-gold" />
                  <span>{project.data.location}</span>
                </div>
              </div>
              <div class="text-right">
                <p class="text-[9px] font-bold text-charcoal/40 uppercase tracking-widest">Pricing Model</p>
                <p class="text-lg font-semibold text-accent-gold">{project.data.price}</p>
              </div>
            </div>

            <p class="text-sm text-charcoal/70 leading-relaxed font-light">
              {project.data.description}
            </p>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 py-4 border-t border-b border-charcoal/5 text-xs text-charcoal/70">
              <div class="flex items-center space-x-2">
                <Store className="w-4 h-4 text-accent-gold flex-shrink-0" />
                <span class="line-clamp-1">{project.data.rooms || "Retail Spaces"}</span>
              </div>
              <div class="flex items-center space-x-2">
                <Building2 className="w-4 h-4 text-accent-gold flex-shrink-0" />
                <span class="line-clamp-1">{project.data.area || "Commercial Mall"}</span>
              </div>
            </div>

            <div class="pt-2">
              <a 
                href={`/projects/${project.id}`} 
                class="inline-flex items-center space-x-2 bg-charcoal hover:bg-accent-gold text-linen hover:text-charcoal px-6 py-3 text-xs font-bold tracking-widest uppercase transition-all duration-300 rounded-sm"
              >
                <span>View Details</span>
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>
  </section>
</BaseLayout>
