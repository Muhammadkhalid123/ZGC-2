---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectFilter from '../../components/ProjectFilter';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
// Format projects payload for prop serialization
const projectsPayload = allProjects.map(p => ({
  id: p.id,
  data: p.data
}));
---

<BaseLayout 
  title="Real Estate Projects in Karachi | Zain Group of Companies" 
  description="Explore the complete real estate portfolio of Zain Group of Companies (ZGC) in Karachi. Use filters to browse apartments and shopping mall developments."
>
  {/* Header */}
  <section class="bg-linen py-16 md:py-24 border-b border-charcoal/5">
    <div class="max-w-7xl mx-auto px-6 text-center space-y-4">
      <span class="text-xs font-bold tracking-[0.25em] uppercase text-accent-gold block">Our Landmarks</span>
      <h1 class="text-4xl md:text-6xl font-light font-display text-charcoal max-w-4xl mx-auto leading-tight">
        Zain Group Property Portfolio
      </h1>
      <p class="text-sm md:text-base text-charcoal/60 max-w-2xl mx-auto font-light leading-relaxed">
        Explore ZGC's completed shopping plazas and upcoming housing residencies. Use the interactive filter to refine your search by building category and project status.
      </p>
    </div>
  </section>

  {/* Filter & Projects Grid Island */}
  <section class="max-w-7xl mx-auto px-6 py-16">
    <ProjectFilter client:load initialProjects={projectsPayload} />
  </section>

</BaseLayout>
