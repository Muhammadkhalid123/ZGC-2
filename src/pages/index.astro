                  </svg>
                </span>
              </summary>
              <p class="text-sm text-white/60 leading-relaxed font-light pb-5 whitespace-pre-line">
                {faq.data.answer}
              </p>
            </details>
          </div>
        ))}
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════════
      9. CONTACT — Two-column sticky details + form
      ═══════════════════════════════════════════════════════════════ */}
