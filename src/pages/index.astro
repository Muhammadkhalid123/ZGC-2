---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
import { getCollection } from 'astro:content';
import { ArrowRight, Phone, Mail, MapPin, Building, Key, ShieldCheck, Compass, Home, Tag, Award, HeartHandshake, Landmark } from 'lucide-react';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter(p => p.data.featured);
const latestBlogs = (await getCollection('blog')).slice(0, 3);
const faqs = await getCollection('faqs');

const projectsDetailList = [
  {
    id: "city-executive-tower",
    title: "City Executive Tower",
    type: "Residential",
    location: "Shahrah-e-Faisal, Karachi",
    price: "PKR 4.5 Crore onwards",
    status: "Under Construction",
    rooms: "3, 4 & 5 Rooms Luxury Flats",
    area: "1,200 – 2,400 Sq. Ft.",
    desc: "A signature residential address crafted with premium engineering, spacious flat layouts, and SBCA-approved safety structures in Karachi's corporate corridor.",
    image: "/images/projects/city-executive.jpg",
  },
  {
    id: "city-towers-shopping-mall",
    title: "City Towers & Shopping Mall",
    type: "Commercial",
    location: "Malir, Karachi",
    price: "PKR 85 Lakh onwards",
    status: "Delivered",
    rooms: "Executive Offices & Shops",
    area: "150 – 1,200 Sq. Ft.",
    desc: "A landmark mixed-use commercial development offering high-yield retail showrooms and modern corporate office setups on Airport Road.",
    image: "/images/projects/city-towers.jpg",
  },
  {
    id: "sun-residency",
    title: "Sun Residency",
    type: "Residential",
    location: "Garden East, Karachi",
    price: "PKR 3.2 Crore onwards",
    status: "Delivered",
    rooms: "3 & 4 Rooms Apartments",
    area: "1,150 – 1,850 Sq. Ft.",
    desc: "A premium gated residential project in the heart of Garden East, offering modern urban comforts and secure family environments with dedicated amenities.",
    image: "/images/projects/sun-residency.jpg",
  },
  {
    id: "afroz-mobile-mall-and-residency",
    title: "Afroz Mobile Mall & Residency",
    type: "Commercial / Mixed-use",
    location: "Gulshan-e-Iqbal, Karachi",
    price: "PKR 95 Lakh onwards",
    status: "Under Construction",
    rooms: "Mobile Shops & Apartments",
    area: "180 – 1,500 Sq. Ft.",
    desc: "Karachi's modern specialized mobile retail hub integrated with premium residential flats, designed for prime business and living in Gulshan.",
    image: "/images/projects/afroz-residency.jpg",
  }
];

const timelineMilestones = [
  { year: "1998", title: "Founded in Karachi", desc: "Established with a vision for safe vertical family housing in PECHS & Malir." },
  { year: "2006", title: "Residential Expansion", desc: "Delivered PECHS residential towers pioneered with standard-tested steel bars." },
  { year: "2014", title: "Commercial Landmarks", desc: "Completed City Towers Shopping Mall on Airport Road with zero title delays." },
  { year: "2022", title: "Sun Residency", desc: "Handed over Garden East luxury gated apartments with milestone-aligned capital protection." },
  { year: "2026", title: "City Executive Tower", desc: "Under construction SBCA-certified high-rise on Shahrah-e-Faisal corporate corridor." }
];
---

<BaseLayout>
  
  {/* ═══════════════════════════════════════════════════════════════
      1. HERO — Background Slideshow with High-Contrast Typography
      ═══════════════════════════════════════════════════════════════ */}
  <section class="relative bg-charcoal min-h-[85vh] lg:min-h-[90vh] flex flex-col items-center justify-center px-6 pt-32 pb-24 overflow-hidden text-white">
    
    {/* Background Slideshow Carousel */}
    <div class="absolute inset-0 z-0 select-none">
      <div class="absolute inset-0 bg-cover bg-center animate-hero-slide-1 opacity-0 scale-105 transition-transform duration-1000" style="background-image: url('/images/projects/banner-2.jpg');"></div>
      <div class="absolute inset-0 bg-cover bg-center animate-hero-slide-2 opacity-0 scale-105 transition-transform duration-1000" style="background-image: url('/images/projects/banner-4.jpg');"></div>
      <div class="absolute inset-0 bg-cover bg-center animate-hero-slide-3 opacity-0 scale-105 transition-transform duration-1000" style="background-image: url('/images/projects/banner-5.jpg');"></div>
      <div class="absolute inset-0 bg-cover bg-center animate-hero-slide-4 opacity-0 scale-105 transition-transform duration-1000" style="background-image: url('/images/projects/banner-6.jpg');"></div>
      
      {/* Dark Overlay Wash — Ensures 100% focus on text without background distraction */}
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/80 to-charcoal/70 backdrop-blur-[2px]"></div>
    </div>

    {/* Hero Content Layer */}
    <div class="relative z-20 max-w-[1200px] mx-auto text-center space-y-8 select-none">
      
      {/* Subtitle */}
      <p class="text-[12px] md:text-[13px] font-sans font-bold text-brand-green tracking-[0.2em] uppercase reveal-up">
        Real estate developers, builders and managers
      </p>
      
      {/* Massive serif headline */}
      <h1 class="text-[clamp(2.5rem,7.5vw,6.5rem)] font-display font-semibold leading-[1.08] text-white tracking-tight reveal-up drop-shadow-lg">
        Doing <em class="font-display italic font-semibold text-brand-green not-italic" style="font-style: italic;">right</em> by those who trust us isn't a strategy — it's the <em class="font-display italic font-semibold text-brand-blue not-italic" style="font-style: italic;">only</em> way we build.
      </h1>

      {/* Descriptor */}
      <p class="text-sm sm:text-base font-sans font-light text-white/80 max-w-xl mx-auto leading-relaxed reveal-up">
        Zain Group of Companies — Karachi's trusted property developer with 25+ years of SBCA-certified construction excellence and 27+ delivered landmarks.
      </p>

      {/* Action Buttons */}
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4 reveal-up">
        <a 
          href="#developments" 
          class="bg-brand-green text-white hover:bg-white hover:text-charcoal px-8 py-3.5 text-xs font-sans font-bold tracking-widest uppercase rounded-full transition-all duration-300 shadow-xl shadow-brand-green/20"
        >
          Explore Portfolio
        </a>
        <a 
          href="/contact" 
          class="border border-white/30 text-white hover:bg-white hover:text-charcoal px-8 py-3.5 text-xs font-sans font-bold tracking-widest uppercase rounded-full transition-all duration-300"
        >
          Schedule Visit
        </a>
      </div>

    </div>
  </section>

  {/* Hero slideshow keyframes */}
  <style>
    @keyframes hero-fade-1 { 0%,100%{opacity:0.45} 20%{opacity:0.45} 25%{opacity:0} 95%{opacity:0} }
    @keyframes hero-fade-2 { 0%,20%,100%{opacity:0} 25%{opacity:0.45} 45%{opacity:0.45} 50%{opacity:0} }
    @keyframes hero-fade-3 { 0%,45%,100%{opacity:0} 50%{opacity:0.45} 70%{opacity:0.45} 75%{opacity:0} }
    @keyframes hero-fade-4 { 0%,70%,100%{opacity:0} 75%{opacity:0.45} 95%{opacity:0.45} }
    .animate-hero-slide-1 { animation: hero-fade-1 20s infinite; }
    .animate-hero-slide-2 { animation: hero-fade-2 20s infinite; }
    .animate-hero-slide-3 { animation: hero-fade-3 20s infinite; }
    .animate-hero-slide-4 { animation: hero-fade-4 20s infinite; }
  </style>


  {/* ═══════════════════════════════════════════════════════════════
      2. STATS — Dark contrast mode with dynamic counter animation
      ═══════════════════════════════════════════════════════════════ */}
  <section class="bg-charcoal text-white border-t border-b border-white/10 py-16 reveal-up">
    <div class="max-w-[1200px] mx-auto grid grid-cols-2 md:grid-cols-4">
      <div class="p-8 md:p-12 border-r border-white/10 text-center space-y-2">
        <span class="text-4xl md:text-6xl font-display font-semibold text-brand-green block stat-counter" data-target="25" data-suffix="+">0+</span>
        <span class="text-[11px] font-sans font-bold uppercase tracking-widest text-white/50 block">Years Experience</span>
      </div>
      <div class="p-8 md:p-12 md:border-r border-white/10 text-center space-y-2">
        <span class="text-4xl md:text-6xl font-display font-semibold text-brand-blue block stat-counter" data-target="27" data-suffix="+">0+</span>
        <span class="text-[11px] font-sans font-bold uppercase tracking-widest text-white/50 block">Delivered Landmarks</span>
      </div>
      <div class="p-8 md:p-12 border-r border-white/10 border-t md:border-t-0 text-center space-y-2">
        <span class="text-4xl md:text-6xl font-display font-semibold text-brand-green block stat-counter" data-target="10000" data-suffix="+">0+</span>
        <span class="text-[11px] font-sans font-bold uppercase tracking-widest text-white/50 block">Happy Families</span>
      </div>
      <div class="p-8 md:p-12 border-t md:border-t-0 text-center space-y-2">
        <span class="text-4xl md:text-6xl font-display font-semibold text-brand-blue block stat-counter" data-target="100" data-suffix="%">0%</span>
        <span class="text-[11px] font-sans font-bold uppercase tracking-widest text-white/50 block">SBCA On-Time Delivery</span>
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════════
      3. HOW WE BUILD — Tandem "HOW WE DIFFER" oversized label
      ═══════════════════════════════════════════════════════════════ */}
  <section class="py-24 md:py-32 reveal-up bg-linen">
    <div class="max-w-[1200px] mx-auto px-6 space-y-16">
      
      {/* Massive uppercase sans-serif label */}
      <div class="space-y-6 text-center">
        <h2 class="text-[clamp(2.5rem,7vw,6rem)] font-sans font-black uppercase leading-none tracking-tight text-charcoal">
          How We Build
        </h2>
        <p class="text-lg md:text-xl font-display italic font-light text-charcoal/50 max-w-2xl mx-auto">
          These principles show how we work and why our clients trust us — a clear commitment that guides every project we deliver.
        </p>
      </div>

      {/* Principle cards — clean borders, hover micro-animations */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0 border border-charcoal/10 reveal-stagger">
        <div class="p-8 border-b lg:border-b-0 lg:border-r border-charcoal/10 space-y-4 reveal-item hover:bg-charcoal/5 transition-colors duration-300">
          <Compass className="w-7 h-7 text-brand-green" />
          <h3 class="text-lg font-display font-semibold text-charcoal">SBCA Certified</h3>
          <p class="text-xs text-charcoal/55 leading-relaxed font-light">
            Every floor plan, structural beam, and elevation drawing is fully approved by the Sindh Building Control Authority.
          </p>
        </div>
        <div class="p-8 border-b lg:border-b-0 lg:border-r border-charcoal/10 space-y-4 reveal-item hover:bg-charcoal/5 transition-colors duration-300">
          <ShieldCheck className="w-7 h-7 text-brand-blue" />
          <h3 class="text-lg font-display font-semibold text-charcoal">Structural Safety</h3>
          <p class="text-xs text-charcoal/55 leading-relaxed font-light">
            Grade-A certified steel bars and premium cement tested to withstand seismic and high-pressure conditions for decades.
          </p>
        </div>
        <div class="p-8 border-b lg:border-b-0 lg:border-r border-charcoal/10 space-y-4 reveal-item hover:bg-charcoal/5 transition-colors duration-300">
          <Key className="w-7 h-7 text-brand-green" />
          <h3 class="text-lg font-display font-semibold text-charcoal">Clean Titles</h3>
          <p class="text-xs text-charcoal/55 leading-relaxed font-light">
            100% verified registry deeds, zero hidden fees, and direct ownership documentation from day one.
          </p>
        </div>
        <div class="p-8 space-y-4 reveal-item hover:bg-charcoal/5 transition-colors duration-300">
          <Building className="w-7 h-7 text-brand-blue" />
          <h3 class="text-lg font-display font-semibold text-charcoal">Flexible Plans</h3>
          <p class="text-xs text-charcoal/55 leading-relaxed font-light">
            36 to 48-month milestone-aligned installments, matching real construction progress to protect your investment.
          </p>
        </div>
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════════
      4. TIME SECTION (TIMELINE) — Animated Chronological Journey
      ═══════════════════════════════════════════════════════════════ */}
  <section class="bg-charcoal text-white py-24 md:py-32 border-t border-b border-white/10 reveal-up">
    <div class="max-w-[1200px] mx-auto px-6 space-y-16">
      
      {/* Section Header */}
      <div class="text-center space-y-4">
        <span class="text-[10px] font-sans font-bold tracking-widest uppercase text-white/30 block">25+ Year Journey</span>
        <h2 class="text-[clamp(2.2rem,6vw,5.5rem)] font-sans font-black uppercase leading-none tracking-tight text-white">
          The Timeline
        </h2>
        <p class="text-lg font-display italic font-light text-white/50 max-w-xl mx-auto">
          Quarter of a century building landmarks, navigating markets, and earning trust across Karachi.
        </p>
      </div>

      {/* Timeline Grid Container */}
      <div class="timeline-container relative max-w-4xl mx-auto pt-8">
        
        {/* Animated Progress Line */}
        <div class="absolute left-6 md:left-1/2 top-10 bottom-10 w-0.5 bg-white/10 -translate-x-1/2">
          <div class="timeline-progress-line w-full h-full bg-brand-green origin-top scale-y-0"></div>
        </div>

        <div class="space-y-12 relative">
          {timelineMilestones.map((m, idx) => {
            const isLeft = idx % 2 === 0;
            return (
              <div class={`relative flex flex-col md:flex-row items-start ${isLeft ? 'md:flex-row-reverse' : ''} group`}>
                
                {/* Node */}
                <div class="absolute left-6 md:left-1/2 -translate-x-1/2 top-2 z-10">
                  <div class="timeline-node w-5 h-5 rounded-full bg-charcoal border-2 border-brand-green group-hover:bg-brand-green transition-colors duration-300"></div>
                </div>

                {/* Content Box */}
                <div class={`ml-14 md:ml-0 md:w-1/2 ${isLeft ? 'md:pr-12 md:text-right' : 'md:pl-12 md:text-left'} space-y-2`}>
                  <span class="text-xs font-mono font-bold tracking-widest text-brand-green uppercase block">{m.year}</span>
                  <h3 class="text-2xl font-display font-semibold text-white">{m.title}</h3>
                  <p class="text-xs text-white/50 leading-relaxed font-light">{m.desc}</p>
                </div>

              </div>
            );
          })}
        </div>

      </div>

      <div class="text-center pt-8 border-t border-white/10">
        <a href="/about-us" class="inline-flex items-center space-x-2 text-xs font-sans font-bold tracking-widest uppercase text-white/40 hover:text-white transition-colors">
          <span>Read Full Legacy Story</span>
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>

    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════════
      5. PORTFOLIO — Alternating editorial project stack
      ═══════════════════════════════════════════════════════════════ */}
  <section id="developments" class="py-24 md:py-32 bg-linen">
    <div class="max-w-[1200px] mx-auto px-6 space-y-24">
      
      {/* Section label */}
      <div class="text-center space-y-4 reveal-up">
        <h2 class="text-[clamp(2.5rem,7vw,6rem)] font-sans font-black uppercase leading-none tracking-tight text-charcoal">
          Portfolio
        </h2>
        <p class="text-lg md:text-xl font-display italic font-light text-charcoal/50 max-w-xl mx-auto">
          A curated selection of developments across Karachi — residential, commercial, and mixed-use.
        </p>
      </div>

      {/* Alternating project rows */}
      <div class="space-y-32">
        {projectsDetailList.map((project, index) => {
          const isEven = index % 2 === 0;
          return (
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center reveal-up">
              
              {/* Image — framed, rounded, with shadow */}
              <div class={`lg:col-span-7 ${isEven ? 'lg:order-1' : 'lg:order-2'}`}>
                <div class="relative aspect-[4/3] overflow-hidden bg-charcoal rounded-md shadow-xl group">
                  <img 
                    src={project.image} 
                    alt={project.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                    loading="lazy"
                  />
                  <div class="absolute top-4 right-4 bg-charcoal/80 backdrop-blur-md text-white px-3 py-1.5 text-[9px] font-sans font-bold tracking-widest uppercase rounded-sm border border-white/10">
                    {project.status}
                  </div>
                </div>
              </div>

              {/* Text column */}
              <div class={`lg:col-span-5 ${isEven ? 'lg:order-2' : 'lg:order-1'} space-y-5`}>
                <div class="space-y-2">
                  <span class="text-[10px] font-sans font-bold tracking-widest text-charcoal/40 uppercase block">
                    {project.type} &bull; {project.location}
                  </span>
                  <h3 class="text-3xl md:text-4xl font-display font-semibold text-charcoal leading-tight">
                    {project.title}
                  </h3>
                </div>
                
                <p class="text-sm text-charcoal/60 leading-relaxed font-light">
                  {project.desc}
                </p>

                {/* Specs — hairline borders */}
                <div class="grid grid-cols-2 gap-3 py-5 border-t border-b border-charcoal/10 text-xs text-charcoal/70">
                  <div class="flex items-center space-x-2">
                    <Tag className="w-4 h-4 text-charcoal/30 flex-shrink-0" />
                    <span class="line-clamp-1">{project.price}</span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <Home className="w-4 h-4 text-charcoal/30 flex-shrink-0" />
                    <span class="line-clamp-1">{project.rooms}</span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <Key className="w-4 h-4 text-charcoal/30 flex-shrink-0" />
                    <span class="line-clamp-1">{project.area}</span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <MapPin className="w-4 h-4 text-charcoal/30 flex-shrink-0" />
                    <span class="line-clamp-1">{project.location.split(',')[0]}</span>
                  </div>
                </div>

                <a 
                  href={`/projects/${project.id}`} 
                  class="inline-flex items-center space-x-2 bg-charcoal text-white hover:bg-brand-green px-7 py-3 text-xs font-sans font-bold tracking-widest uppercase transition-all duration-300 rounded-sm"
                >
                  <span>Discover</span>
                  <ArrowRight className="w-4 h-4" />
                </a>
              </div>

            </div>
          );
        })}
      </div>

      {/* View all link */}
      <div class="text-center pt-8 border-t border-charcoal/10 reveal-up">
        <a href="/projects" class="text-sm font-sans font-bold tracking-wider uppercase text-charcoal/40 hover:text-charcoal transition-colors">
          View All Projects &rarr;
        </a>
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════════
      6. SPLIT CTA — Residential vs Commercial
      ═══════════════════════════════════════════════════════════════ */}
  <section class="grid grid-cols-1 md:grid-cols-2 border-t border-charcoal/10">
    <div class="relative h-[480px] flex items-center justify-center overflow-hidden bg-charcoal group">
      <div class="absolute inset-0 bg-cover bg-center opacity-40 group-hover:scale-105 transition-transform duration-700" style="background-image: url('/images/projects/city-towers.jpg');"></div>
      <div class="relative z-10 text-center space-y-4 px-6">
        <h3 class="text-3xl md:text-4xl font-display font-semibold text-white">Commercial</h3>
        <p class="text-sm text-white/65 max-w-sm mx-auto font-light">Retail showrooms, corporate offices, and mall units in Karachi.</p>
        <div class="pt-2">
          <a href="/commercial-properties" class="inline-flex items-center space-x-2 bg-white text-charcoal hover:bg-brand-green hover:text-white px-6 py-3 text-xs font-sans font-bold tracking-widest uppercase transition-all duration-300 rounded-sm">
            <span>Explore Commercial</span>
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
    <div class="relative h-[480px] flex items-center justify-center overflow-hidden bg-charcoal group">
      <div class="absolute inset-0 bg-cover bg-center opacity-40 group-hover:scale-105 transition-transform duration-700" style="background-image: url('/images/projects/sun-residency.jpg');"></div>
      <div class="relative z-10 text-center space-y-4 px-6">
        <h3 class="text-3xl md:text-4xl font-display font-semibold text-white">Residential</h3>
        <p class="text-sm text-white/65 max-w-sm mx-auto font-light">Premium apartments, family flats, and luxury residencies.</p>
        <div class="pt-2">
          <a href="/apartments-for-sale" class="inline-flex items-center space-x-2 bg-white text-charcoal hover:bg-brand-green hover:text-white px-6 py-3 text-xs font-sans font-bold tracking-widest uppercase transition-all duration-300 rounded-sm">
            <span>Explore Residential</span>
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════════
      7. BLOG — Clean editorial cards
      ═══════════════════════════════════════════════════════════════ */}
  <section class="max-w-[1200px] mx-auto px-6 py-24 md:py-32 space-y-12 reveal-up">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-charcoal/10 pb-6">
      <div class="space-y-2">
        <span class="text-[10px] font-sans font-bold tracking-widest uppercase text-charcoal/40 block">Insights</span>
        <h2 class="text-3xl md:text-4xl font-display font-semibold text-charcoal">Latest Articles</h2>
      </div>
      <a href="/blog" class="text-xs font-sans font-bold tracking-wider uppercase text-charcoal/40 hover:text-charcoal transition-colors">
        Read All &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {latestBlogs.map(post => (
        <article class="flex flex-col space-y-4 group">
          <div class="relative aspect-[16/10] bg-charcoal/5 rounded-md overflow-hidden shadow-md">
            {(() => {
              let blogImg = "/images/projects/sun-residency.jpg";
              if (post.data.title.toLowerCase().includes("compare") || post.data.title.toLowerCase().includes("projects")) blogImg = "/images/projects/city-towers.jpg";
              else if (post.data.title.toLowerCase().includes("luxury") || post.data.title.toLowerCase().includes("affordable")) blogImg = "/images/projects/city-executive.jpg";
              else if (post.data.title.toLowerCase().includes("shop") || post.data.title.toLowerCase().includes("office")) blogImg = "/images/projects/afroz-residency.jpg";
              return (
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-[1.03]" style={`background-image: url('${blogImg}');`}></div>
              );
            })()}
          </div>
          <div class="space-y-2">
            <time class="text-[10px] font-sans font-bold text-charcoal/40 uppercase tracking-widest block">{post.data.date}</time>
            <h3 class="text-xl font-display font-semibold text-charcoal leading-snug group-hover:text-charcoal/60 transition-colors">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="text-xs text-charcoal/60 leading-relaxed line-clamp-3 font-light">{post.data.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════════
      8. FAQ — High contrast dark mode accordion
      ═══════════════════════════════════════════════════════════════ */}
  <section class="bg-charcoal text-white py-24 md:py-32 reveal-up">
    <div class="max-w-3xl mx-auto px-6 space-y-12">
      <div class="text-center space-y-4">
        <h2 class="text-3xl md:text-5xl font-display font-semibold text-white">Frequently Asked</h2>
        <p class="text-sm text-white/50 font-light max-w-md mx-auto">Booking procedures, installment plans, and construction timelines.</p>
      </div>

      <div class="space-y-0">
        {faqs.map((faq) => (
          <div class="border-b border-white/10">
            <details class="group">
              <summary class="flex justify-between items-center cursor-pointer list-none py-5 text-white/80 hover:text-white transition-colors">
