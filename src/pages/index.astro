            <p class="text-sm text-charcoal/70 font-light">+92 330 2382380</p>
          </div>
        </div>
        <div class="flex items-start space-x-3">
          <Mail className="w-5 h-5 text-charcoal/30 mt-0.5 flex-shrink-0" />
          <div>
            <h4 class="text-xs font-sans font-bold text-charcoal/50 uppercase tracking-wider mb-1">Email</h4>
            <p class="text-sm text-charcoal/70 font-light">info@zgc.com.pk</p>
          </div>
        </div>
      </div>

      <div class="h-56 border border-charcoal/10 rounded-md overflow-hidden shadow-inner">
        <iframe 
          title="ZGC Head Office"
          src="https://maps.google.com/maps?q=Survey%20No.%20535/1,%20Deh%20Mehran%20Tapo%20Airport,%20Malir,%20Karachi&t=&z=15&ie=UTF8&iwloc=&output=embed" 
          width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"
        ></iframe>
      </div>
    </div>

    <ContactForm client:visible />
  </section>

